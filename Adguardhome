#!/bin/sh
# install-adguardhome-openwrt.sh
#
# Fully unattended install of AdGuard Home on OpenWrt (compatible with PassWall2).
# - Installs AdGuard Home
# - Completes its setup wizard automatically via its own local API (no browser needed)
# - Moves dnsmasq to port 54, forwards DNS to AdGuard Home on port 53
# - Pushes the router as DNS server to clients via DHCP option 6
#
# Usage:
#   chmod +x install-adguardhome-openwrt.sh
#   ./install-adguardhome-openwrt.sh
#
# You will be prompted for an admin username and password during the run.

set -e

ROUTER_IP="192.168.1.1"          # router LAN IP
DNSMASQ_PORT="54"                # port to move dnsmasq to
LAN_IFACE="lan"                  # LAN interface name in /etc/config/network (dhcp section)

echo "==> [0/5] AdGuard Home admin account setup"
printf "Enter admin username [admin]: "
read ADMIN_USER
ADMIN_USER="${ADMIN_USER:-admin}"

while true; do
  printf "Enter admin password (min 8 chars): "
  read -s ADMIN_PASS
  echo ""
  if [ -z "$ADMIN_PASS" ] || [ "${#ADMIN_PASS}" -lt 8 ]; then
    echo "Password too short/empty. Try again."
    continue
  fi
  printf "Confirm password: "
  read -s ADMIN_PASS_CONFIRM
  echo ""
  if [ "$ADMIN_PASS" != "$ADMIN_PASS_CONFIRM" ]; then
    echo "Passwords did not match. Try again."
    continue
  fi
  break
done

echo "==> [1/5] Moving dnsmasq off port 53 first (so AdGuard Home can bind it)..."
uci set dhcp.@dnsmasq[0].port="${DNSMASQ_PORT}"
uci set dhcp.@dnsmasq[0].noresolv='1'
uci add_list dhcp.@dnsmasq[0].server='127.0.0.1#53'
uci commit dhcp
/etc/init.d/dnsmasq restart
sleep 2

echo "==> [2/5] Installing AdGuard Home..."
curl -s -S -L https://raw.githubusercontent.com/AdguardTeam/AdGuardHome/master/scripts/install.sh | sh -s -- -v

echo "==> [3/5] Waiting for AdGuard Home web interface to come up..."
i=0
until curl -s -o /dev/null "http://127.0.0.1:3000/control/status"; do
  i=$((i+1))
  if [ "$i" -gt 30 ]; then
    echo "AdGuard Home did not start in time. Check: /etc/init.d/AdGuardHome status"
    exit 1
  fi
  sleep 1
done

echo "==> [4/5] Completing setup wizard via API (skips the browser wizard)..."
curl -s -X POST "http://127.0.0.1:3000/control/install/configure" \
  -H "Content-Type: application/json" \
  -d "{\"web\":{\"ip\":\"0.0.0.0\",\"port\":3000},\"dns\":{\"ip\":\"0.0.0.0\",\"port\":53},\"username\":\"${ADMIN_USER}\",\"password\":\"${ADMIN_PASS}\"}" \
  > /tmp/agh_setup_response.json
cat /tmp/agh_setup_response.json
echo ""
echo "    (If this returned an error, your AdGuard Home version may have changed"
echo "     its setup API — fall back to visiting http://${ROUTER_IP}:3000 once manually.)"

echo "==> [5/5] Forcing LAN clients to use AdGuard Home via DHCP option 6..."
uci set dhcp.${LAN_IFACE}.dhcp_option="6,${ROUTER_IP}"
uci commit dhcp
/etc/init.d/dnsmasq restart

echo ""
echo "Done. AdGuard Home is installed and configured, no wizard needed."
echo "  - Dashboard: http://${ROUTER_IP}:3000"
echo "  - Login: ${ADMIN_USER} / (the password you set)"
echo "  - If PassWall2 handles some clients directly, make sure it doesn't hijack port 53"
echo "    traffic before it reaches dnsmasq/AdGuard, or DNS forwarding above won't apply."
